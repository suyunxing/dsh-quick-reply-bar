{
  "name": "dsh-quick-reply-bar",
  "version": "1.0.1",
  "description": "输入框上方的可收起快捷回复条：收起时是一个小按钮，展开是一横排短语，点一下直接发送。A collapsible quick-reply bar above the composer: collapsed it is one small button, expanded a horizontal strip of phrases that send on a single click.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "suyunxing"
  },
  "homepage": "https://github.com/suyunxing/dsh-quick-reply-bar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyunxing/dsh-quick-reply-bar.git"
  },
  "bugs": {
    "url": "https://github.com/suyunxing/dsh-quick-reply-bar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "web-ui",
    "ui",
    "composer",
    "input",
    "quick-reply",
    "quick-replies",
    "shortcut",
    "canned-responses",
    "productivity"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
